FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false OMP_NUM_THREADS=2 MKL_NUM_THREADS=2
WORKDIR /app
RUN pip install --no-cache-dir pip==26.2.2 setuptools==84.2.1
RUN pip install --no-cache-dir torch==2.14.1 --index-url https://download.pytorch.org/whl/cpu
COPY requirements-ka.txt requirements-ka.lock ./
RUN pip install --no-cache-dir --no-deps -r requirements-ka.lock && pip check
COPY aidetector ./aidetector
COPY ka_detector ./ka_detector
COPY models ./upstream-metadata
COPY LICENSE ./LICENSE
RUN useradd --uid 10001 --create-home detector && mkdir -p /models /runs && chown detector:detector /runs
USER detector
EXPOSE 8020
HEALTHCHECK --interval=15s --timeout=5s --start-period=90s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8020/health', timeout=3)"
CMD ["uvicorn", "ka_detector.api:app", "--host", "0.0.0.0", "--port", "8020", "--no-access-log", "--limit-concurrency", "12"]
